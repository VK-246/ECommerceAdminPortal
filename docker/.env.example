# ---------------------------------------------------------
# Environment Variables — E-Commerce Admin Portal (Docker)
# ---------------------------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file to source control.
# ---------------------------------------------------------

# PostgreSQL
POSTGRES_DB=ecommerce_admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# pgAdmin (optional web UI)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Gemini AI (Google AI Studio — https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — comma-separated list of allowed frontend origins
# Local dev: http://localhost:4200
# Production (Render): https://vinayak-portfolio.dev
CORS_ALLOWED_ORIGINS=http://localhost:4200
